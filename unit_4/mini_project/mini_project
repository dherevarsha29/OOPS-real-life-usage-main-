#include <fstream>
#include <iostream>
#include <limits>
#include <sstream>
#include <string>

using namespace std;

// Class to represent a book
class Book
{
private:
    int bookId;
    string title;
    string author;
    bool issued;

public:
    // Constructor to initialize book details
    Book(int id, string bookTitle, string bookAuthor, bool issueStatus = false)
        : bookId(id), title(bookTitle), author(bookAuthor), issued(issueStatus)
    {
    }

    // Return the book ID
    int getBookId() const
    {
        return bookId;
    }

    // Convert book details into a file record
    string toFileRecord() const
    {
        return to_string(bookId) + "|" + title + "|" + author + "|" +
               (issued ? "1" : "0");
    }

    // Display book details
    void display() const
    {
        cout << "Book ID: " << bookId << '\n';
        cout << "Title: " << title << '\n';
        cout << "Author: " << author << '\n';
        cout << "Status: " << (issued ? "Issued" : "Available") << '\n';
    }
};

// Function to add a new book
void addBook()
{
    int id;
    string title;
    string author;

    // Get book ID
    cout << "Enter book ID: ";
    cin >> id;

    // Clear input buffer
    cin.ignore(numeric_limits<streamsize>::max(), '\n');

    // Get book title
    cout << "Enter title: ";
    getline(cin, title);

    // Get author name
    cout << "Enter author: ";
    getline(cin, author);

    // Create Book object
    Book book(id, title, author);

    // Open file in append mode
    ofstream outputFile("library_books.txt", ios::app);

    // Check if file opened successfully
    if (!outputFile)
    {
        cerr << "Error: Could not open library_books.txt\n";
        return;
    }

    // Write book record into the file
    outputFile << book.toFileRecord() << '\n';

    cout << "Book added successfully.\n";
}

// Function to display all books
void displayBooks()
{
    // Open the file for reading
    ifstream inputFile("library_books.txt");

    // Check if file exists
    if (!inputFile)
    {
        cout << "No library record file found.\n";
        return;
    }

    string line;

    // Read the file line by line
    while (getline(inputFile, line))
    {
        // Use stringstream to separate fields
        stringstream record(line);

        string idText;
        string title;
        string author;
        string issuedText;

        // Extract book details using | as delimiter
        if (getline(record, idText, '|') &&
            getline(record, title, '|') &&
            getline(record, author, '|') &&
            getline(record, issuedText))
        {
            // Create Book object from file data
            Book book(stoi(idText), title, author, issuedText == "1");

            // Display book details
            book.display();

            cout << "-------------------------\n";
        }
    }
}

// Main function
int main()
{
    int choice;

    // Display menu repeatedly
    do
    {
        cout << "\nLibrary Record System\n";
        cout << "1. Add Book\n";
        cout << "2. Display Books\n";
        cout << "0. Exit\n";
        cout << "Enter choice: ";
        cin >> choice;

        // Perform operation according to user's choice
        switch (choice)
        {
        case 1:
            addBook();
            break;

        case 2:
            displayBooks();
            break;

        case 0:
            cout << "Exiting program.\n";
            break;

        default:
            cout << "Invalid choice.\n";
        }

    } while (choice != 0);

    return 0;
}
